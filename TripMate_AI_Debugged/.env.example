# Required by the LangGraph PostgreSQL checkpointer.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required by the travel-planning LLM.
GROQ_API_KEY=
# Defaults to openai/gpt-oss-120b. Use a model currently enabled for your account.
GROQ_MODEL=openai/gpt-oss-120b

# Optional integrations; without keys, their results are reported as unavailable.
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# Required in production for signed browser sessions; generate with secrets.token_urlsafe(48).
APP_SECRET_KEY=
# Set to production to require PostgreSQL and a stable APP_SECRET_KEY.
APP_ENV=development
